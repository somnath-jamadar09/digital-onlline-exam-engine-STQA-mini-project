{
  "name": "online-exam-engine",
  "version": "1.0.0",
  "description": "Online examination & automated evaluation engine with timed tests, immediate results, and an STQA test suite",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test:api": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=results/api-junit.xml \"tests/api/*.test.js\"",
    "test:ui": "playwright test",
    "test:perf": "node tests/perf/load-test.js",
    "test:perf:quick": "node tests/perf/load-test.js --quick",
    "test": "npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
